NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" depois de ativar o provedor Google no Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# ID do cliente OAuth do Google (o mesmo cadastrado no Supabase); ativa o "Continuar como …"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Somente servidor. Nunca use prefixo NEXT_PUBLIC_ nestas chaves.
SUPABASE_SERVICE_ROLE_KEY=

# Lembretes por Web Push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional; padrão: NEXT_PUBLIC_SITE_URL
VAPID_SUBJECT=
# Mesmo valor salvo no Vault do Supabase como flowy_cron_secret
CRON_SECRET=
